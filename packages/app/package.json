{
  "name": "@a11y-fixer/app",
  "version": "0.1.0",
  "description": "a11y-fixer control plane (GitHub App + webhook sink + dashboard). Private SaaS.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.src.json",
    "typecheck": "tsc --noEmit -p tsconfig.src.json",
    "build:next": "next build --webpack",
    "dev": "next dev --webpack",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "ledger:verify": "tsx scripts/ledger-verify.ts",
    "conformance:check-key": "node scripts/check-conformance-key.mjs"
  },
  "dependencies": {
    "@a11y-fixer/core": "workspace:*",
    "@a11y-fixer/licensing": "workspace:*",
    "@sparticuz/chromium": "^158.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@vercel/analytics": "^2.0.1",
    "docx": "^9.16.0",
    "next": "^16.4.6",
    "puppeteer-core": "^25.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
