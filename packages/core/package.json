{
  "name": "@a11y-fixer/core",
  "version": "0.1.2",
  "description": "Deterministic WCAG accessibility fixers for JSX/HTML source.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "axe-core",
    "eslint-plugin-jsx-a11y"
  ],
  "homepage": "https://github.com/a11y-fixer/a11y-fixer#readme",
  "bugs": "https://github.com/a11y-fixer/a11y-fixer/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a11y-fixer/a11y-fixer.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@axe-core/puppeteer": "^4.14.0",
    "@octokit/rest": "^22.0.1",
    "@typescript-eslint/parser": "^8.72.0",
    "axe-core": "^4.10.0",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "parse5": "^7.2.1"
  },
  "optionalDependencies": {
    "puppeteer": "^23.0.0",
    "puppeteer-core": "^23.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "@axe-core/puppeteer": ">=4.0.0",
    "puppeteer": ">=21.0.0"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    },
    "@axe-core/puppeteer": {
      "optional": true
    }
  }
}
