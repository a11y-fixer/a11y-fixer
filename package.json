{
  "name": "a11y-fixer-pro",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "coverage": "pnpm -r run coverage",
    "typecheck": "pnpm -r run typecheck",
    "bench:detect": "pnpm --filter @a11y-fixer/bench-act-detection run bench",
    "bench:fix": "pnpm --filter @a11y-fixer/bench-fix-clearance run bench"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@types/node": "^26.6.6"
  },
  "pnpm": {
    "overrides": {
      "vite": "^7.0.0"
    }
  }
}
